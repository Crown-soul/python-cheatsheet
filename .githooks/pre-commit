#!/usr/bin/env python3
"""commit 前掃描「這次新增的內容」有沒有金鑰、密碼、token。

這個 repo 是公開的，推上去的東西任何人都看得到，而且刪掉也還留在歷史裡。
所以在 commit 之前先擋一次，不要靠記憶力。

只檢查 staged diff 裡「+ 開頭的新增行」，既有內容不會被重複挑毛病
（筆記本身就在教金鑰不能進 commit，裡面有示範用的假密碼）。

真的要強行 commit：git commit --no-verify
手動掃描：python3 .githooks/pre-commit
"""
import re
import subprocess
import sys

# 一看就知道是真金鑰，一律擋
HIGH = [
    ("OpenAI API key", re.compile(r"\bsk-[A-Za-z0-9_-]{20,}")),
    ("GitHub token", re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}")),
    ("GitHub PAT", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}")),
    ("AWS access key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}")),
    ("Anthropic API key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
    ("私密金鑰檔內容", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("連線字串內含密碼", re.compile(r"\b(?:mysql|postgres|postgresql|mongodb)(?:\+srv)?://[^\s:]+:[^\s@]{6,}@")),
]

# 像是把祕密寫死在程式裡，但也可能只是教學範例，所以比對佔位字再決定
ASSIGN = re.compile(
    r"""(?ix)
    \b(api[_-]?key|apikey|secret|password|passwd|token|access[_-]?key|private[_-]?key)
    \s*[:=]\s*
    ["']([^"']{12,})["']
    """
)

# 這些值一看就是佔位或教學用，不算外洩
# 佔位字要「整個值」都像佔位，而且長度有限；
# my / your 後面一定要有分隔符，不然 MySuperRealPassword2026 會被當成佔位字放過去
PLACEHOLDER = re.compile(
    r"(?i)^(?:x{3,}|a{3,}|1+|0+|abc\d*|"
    r"(?:test|demo|sample|example|dummy|fake|foo|bar)[_-]?\w{0,12}|"
    r"placeholder|changeme|secret|password|"
    r"(?:my|your)[_-]\w{0,15}|"
    r"<[^>]+>|\{+[^}]*\}+|\$\{[^}]*\}|\.{3,}|"
    r"[你妳]的\w{0,12}|範例\w{0,8}|請填\w{0,8}|這裡填\w{0,8})$"
)


def staged_added_lines():
    """回傳 [(檔名, 行號, 內容)]，只含這次新增的行。"""
    try:
        diff = subprocess.run(
            ["git", "diff", "--cached", "--unified=0", "--no-color",
             "--diff-filter=ACM", "-M"],
            capture_output=True, text=True, check=True, errors="replace").stdout
    except subprocess.CalledProcessError:
        return []

    out, path, lineno = [], None, 0
    for line in diff.splitlines():
        if line.startswith("+++ b/"):
            path = line[6:]
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            lineno = int(m.group(1)) if m else 0
        elif line.startswith("+") and not line.startswith("+++"):
            if path:
                out.append((path, lineno, line[1:]))
            lineno += 1
    return out


def scan():
    hits = []
    for path, lineno, text in staged_added_lines():
        for label, pat in HIGH:
            m = pat.search(text)
            if m:
                hits.append((path, lineno, label, m.group(0)))

        m = ASSIGN.search(text)
        if m and not PLACEHOLDER.match(m.group(2).strip()):
            hits.append((path, lineno, f"寫死的 {m.group(1)}", m.group(0)))
    return hits


def mask(s):
    s = s.strip()
    return s if len(s) <= 16 else s[:8] + "…" + s[-4:]


def main():
    hits = scan()
    if not hits:
        return 0

    print("", file=sys.stderr)
    print("✋ commit 擋下來了：這次新增的內容裡有像金鑰的東西。", file=sys.stderr)
    print("   這個 repo 是公開的，推上去任何人都看得到，刪掉也還留在歷史裡。",
          file=sys.stderr)
    print("", file=sys.stderr)
    for path, lineno, label, snippet in hits:
        print(f"   {path}:{lineno}  [{label}]  {mask(snippet)}", file=sys.stderr)
    print("", file=sys.stderr)
    print("   怎麼處理：", file=sys.stderr)
    print("   1. 把值搬到 .env，程式改讀 os.environ（.env 已經在 .gitignore 裡）", file=sys.stderr)
    print("   2. 已經外流過的金鑰，去發行的服務作廢再換一把新的", file=sys.stderr)
    print("   3. 確定是教學用的假值：git commit --no-verify", file=sys.stderr)
    print("", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
